          "name": "Alert UUID",
          "description": "The UUID of the alert to dismiss."
        },
        "entry_id": {
          "name": "Config entry",
          "description": "Target a specific TrueNAS config entry (only needed when more than one is configured)."
        }
      }
    },
    "restore_alert": {
      "name": "Restore alert",
      "description": "Un-dismiss (restore) a previously dismissed TrueNAS alert by its UUID.",
