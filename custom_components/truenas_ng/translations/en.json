        "step": {
          "confirm": {
            "title": "Dismiss TrueNAS alert",
            "description": "{alert}\n\nDismiss this alert on the TrueNAS server? This calls alert.dismiss and clears the repair."
          }
        }
      }
    }
  },
  "services": {
    "dismiss_alert": {
      "name": "Dismiss alert",
      "description": "Dismiss a TrueNAS alert by its UUID.",
